// outside_main.pj
//
// Top-level `func` definitions no longer have to live inside
// `public class main(@self){...}` -- they can sit right alongside it in
// the file, before or after, in whatever order reads best. `run()` hoists
// every top-level function (and class) before executing main's
// statements, so it doesn't matter that `add` is defined below the code
// that calls it.

func square(n: Int) -> Int {
    return n * n;
}

public class main(@self){
    println("6 squared is " + toStr(square(6)));
    println("2 + 3 is " + toStr(add(2, 3)));
}

func add(a: Int, b: Int) -> Int {
    return a + b;
}
